<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Startup screen: the OMH splash shows from the moment the app
         process starts (window background), then MainActivity holds an
         identical overlay up for about 1.5 seconds so the logo and
         facility name are actually seen, then lifts it. -->
    <style name="OmhSplash" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
