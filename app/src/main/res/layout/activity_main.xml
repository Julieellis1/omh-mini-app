<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============ HOME: today's roster ============ -->
        <LinearLayout
            android:id="@+id/homeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OMH Mini — Attendance"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rosterInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Loading roster…"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/queueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No records waiting to sync."
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/syncButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sync now"
                    android:textSize="16sp"
                    android:minHeight="52dp" />

                <Button
                    android:id="@+id/refreshButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Refresh roster"
                    android:textSize="16sp"
                    android:minHeight="52dp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Who is signing in or out? (today only)"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/staffList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@null"
                android:text="Server settings"
                android:textColor="#1565C0"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- ============ SETUP: server URL + kiosk token ============ -->
        <LinearLayout
            android:id="@+id/setupGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Server settings"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Set up once by the super admin. The kiosk token is the facility secret — never share it or show it to staff."
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Server address"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/serverUrlEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="https://omh.teta.dpdns.org"
                android:inputType="textUri"
                android:textSize="16sp"
                android:minHeight="52dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Kiosk token"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/tokenEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Paste the kiosk token here"
                android:inputType="textPassword"
                android:textSize="16sp"
                android:minHeight="52dp" />

            <Button
                android:id="@+id/saveSetupButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Save and test connection"
                android:textSize="18sp"
                android:minHeight="56dp" />

            <TextView
                android:id="@+id/setupStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textSize="15sp" />

            <Button
                android:id="@+id/setupBackButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Back"
                android:textSize="16sp"
                android:minHeight="52dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ============ DETAIL: person + duty team ============ -->
        <LinearLayout
            android:id="@+id/detailGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/detailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailDuty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="16sp" />

            <TextView
                android:id="@+id/detailTeam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="16sp" />

            <Button
                android:id="@+id/signInButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Sign in"
                android:textSize="18sp"
                android:minHeight="56dp" />

            <Button
                android:id="@+id/signOutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sign out"
                android:textSize="18sp"
                android:minHeight="56dp" />

            <Button
                android:id="@+id/detailBackButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Back to names"
                android:textSize="16sp"
                android:minHeight="52dp" />

        </LinearLayout>

        <!-- ============ CAMERA: selfie then QR ============ -->
        <LinearLayout
            android:id="@+id/cameraGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Starting…"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:layout_marginTop="12dp"
                android:background="#222222">

                <SurfaceView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/photoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:textSize="16sp" />

            <Button
                android:id="@+id/captureButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Take selfie (front camera)"
                android:textSize="18sp"
                android:minHeight="56dp" />

            <Button
                android:id="@+id/retakeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Retake selfie"
                android:textSize="18sp"
                android:minHeight="56dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/toQrButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Continue to QR scan (back camera)"
                android:textSize="18sp"
                android:minHeight="56dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/cameraBackButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cancel"
                android:textSize="16sp"
                android:minHeight="52dp" />

        </LinearLayout>

        <!-- ============ DONE: confirmation ============ -->
        <LinearLayout
            android:id="@+id/doneGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/doneText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/doneDetailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textSize="16sp" />

            <Button
                android:id="@+id/doneButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Done"
                android:textSize="18sp"
                android:minHeight="56dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
