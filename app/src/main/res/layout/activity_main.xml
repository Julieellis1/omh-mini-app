<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============ HOME: logo + two buttons, nothing else ============ -->
        <LinearLayout
            android:id="@+id/homeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:contentDescription="Oluwatodupefun Maternity Home logo"
                android:src="@drawable/omh_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Oluwatodupefun Maternity Home"
                android:textColor="@color/forest_900"
                android:textSize="21sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/attendanceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Attendance"
                android:textSize="20sp"
                android:minHeight="72dp" />

            <Button
                android:id="@+id/handoversButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Handing Over"
                android:textSize="20sp"
                android:minHeight="72dp" />

            <TextView
                android:id="@+id/handoverInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/queueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="No records waiting to sync."
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/syncButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sync now"
                    android:textSize="15sp"
                    android:minHeight="48dp" />

                <Button
                    android:id="@+id/refreshButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Refresh roster"
                    android:textSize="15sp"
                    android:minHeight="48dp" />

            </LinearLayout>

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@null"
                android:text="Server settings"
                android:textColor="@color/gold_dark"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- ============ NAMES: today's roster (from Attendance) ============ -->
        <LinearLayout
            android:id="@+id/namesGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Attendance"
                android:textColor="@color/forest_900"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rosterInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Loading roster…"
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/namesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Who is signing in or out? (today only)"
                android:textColor="@color/forest_900"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/staffList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/namesBackButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Back"
                android:textSize="16sp"
                android:minHeight="52dp" />

        </LinearLayout>

        <!-- ============ SETUP: server URL + kiosk token ============ -->
        <LinearLayout
            android:id="@+id/setupGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/setupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Server settings"
                android:textColor="@color/forest_900"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Set up once by the super admin. The kiosk token is the facility secret — never share it or show it to staff."
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Server address"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/serverUrlEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="https://omh.teta.dpdns.org"
                android:inputType="textUri"
                android:textSize="16sp"
                android:minHeight="52dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Kiosk token"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/tokenEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Paste the kiosk token here"
                android:inputType="textPassword"
                android:textSize="16sp"
                android:minHeight="52dp" />

            <Button
                android:id="@+id/saveSetupButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Save and test connection"
                android:textSize="18sp"
                android:minHeight="56dp" />

            <TextView
                android:id="@+id/setupStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textSize="15sp" />

            <Button
                android:id="@+id/setupBackButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Back"
                android:textSize="16sp"
                android:minHeight="52dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ============ DETAIL: person + duty team ============ -->
        <LinearLayout
            android:id="@+id/detailGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/detailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/forest_900"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailDuty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="@color/ink_soft"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/detailTeam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="@color/ink_soft"
                android:textSize="16sp" />

            <Button
                android:id="@+id/signInButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Sign in"
                android:textSize="18sp"
                android:minHeight="56dp" />

            <Button
                android:id="@+id/signOutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sign out"
                android:textSize="18sp"
                android:minHeight="56dp" />

            <Button
                android:id="@+id/detailBackButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Back to names"
                android:textSize="16sp"
                android:minHeight="52dp" />

        </LinearLayout>

        <!-- ============ CAMERA: selfie then QR ============ -->
        <LinearLayout
            android:id="@+id/cameraGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Starting…"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:layout_marginTop="12dp"
                android:background="@color/forest_950">

                <SurfaceView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/photoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:textSize="16sp" />

            <Button
                android:id="@+id/captureButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Take selfie (front camera)"
                android:textSize="18sp"
                android:minHeight="56dp" />

            <Button
                android:id="@+id/retakeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Retake selfie"
                android:textSize="18sp"
                android:minHeight="56dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/toQrButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Continue to QR scan (back camera)"
                android:textSize="18sp"
                android:minHeight="56dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/cameraBackButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cancel"
                android:textSize="16sp"
                android:minHeight="52dp" />

        </LinearLayout>

        <!-- ============ DONE: confirmation ============ -->
        <LinearLayout
            android:id="@+id/doneGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/doneText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/forest_900"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/doneDetailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="@color/ink_soft"
                android:textSize="16sp" />

            <Button
                android:id="@+id/doneButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Done"
                android:textSize="18sp"
                android:minHeight="56dp" />

        </LinearLayout>

        <!-- ============ HANDOVER LIST: today's handovers ============ -->
        <LinearLayout
            android:id="@+id/handoverListGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Handovers — today"
                android:textColor="@color/forest_900"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/handoverListInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />

            <Button
                android:id="@+id/createHandoverButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Create handover"
                android:textSize="18sp"
                android:minHeight="56dp" />

            <LinearLayout
                android:id="@+id/handoverList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/handoverListBackButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Back to home"
                android:textSize="16sp"
                android:minHeight="52dp" />

        </LinearLayout>

        <!-- ============ HANDOVER DETAIL: read + acknowledge ============ -->
        <LinearLayout
            android:id="@+id/handoverDetailGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/handoverDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/forest_900"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/handoverDetailMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/handoverDetailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:textColor="@color/forest_800"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/handoverDetailPatients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:textColor="@color/forest_800"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/handoverDetailNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text=""
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />

            <Button
                android:id="@+id/acknowledgeAsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Acknowledge as…"
                android:textSize="18sp"
                android:minHeight="56dp" />

            <LinearLayout
                android:id="@+id/ackList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/acknowledgeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Acknowledge receipt"
                android:textSize="18sp"
                android:minHeight="56dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/handoverDetailBackButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Back to handovers"
                android:textSize="16sp"
                android:minHeight="52dp" />

        </LinearLayout>

        <!-- ============ HANDOVER FORM: create ============ -->
        <LinearLayout
            android:id="@+id/handoverFormGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create handover"
                android:textColor="@color/forest_900"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Step 1: who is handing over -->
            <LinearLayout
                android:id="@+id/formPickGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Who is handing over?"
                    android:textColor="@color/forest_900"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/formCreatorList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- Step 2: the handover itself -->
            <LinearLayout
                android:id="@+id/formFieldsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/formCreatorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:textColor="@color/forest_900"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/formFromText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textColor="@color/ink_soft"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Hand over to:"
                    android:textColor="@color/forest_900"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/formToList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Priority"
                    android:textColor="@color/forest_900"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/formPriorityNormal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Normal"
                        android:textSize="16sp"
                        android:minHeight="52dp" />

                    <Button
                        android:id="@+id/formPriorityUrgent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Urgent"
                        android:textSize="16sp"
                        android:minHeight="52dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Situation — what is happening now? (required)"
                    android:textColor="@color/forest_900"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/situationEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top"
                    android:hint="e.g. Two mothers in labour, one postnatal mother due for discharge."
                    android:inputType="textMultiLine|textCapSentences"
                    android:minHeight="80dp"
                    android:minLines="3"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Background (optional)"
                    android:textColor="@color/forest_900"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/backgroundEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top"
                    android:hint="What led here?"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minHeight="64dp"
                    android:minLines="2"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Assessment (optional)"
                    android:textColor="@color/forest_900"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/assessmentEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top"
                    android:hint="What do you make of it?"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minHeight="64dp"
                    android:minLines="2"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Recommendation (optional)"
                    android:textColor="@color/forest_900"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/recommendationEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top"
                    android:hint="What should the next team do?"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minHeight="64dp"
                    android:minLines="2"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Patients (optional)"
                    android:textColor="@color/forest_900"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/formPatientsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/addPatientButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="+ Add patient note"
                    android:textSize="15sp"
                    android:minHeight="52dp" />

                <Button
                    android:id="@+id/formSaveButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Save handover"
                    android:textSize="18sp"
                    android:minHeight="56dp" />

                <TextView
                    android:id="@+id/formStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:textColor="@color/ink_soft"
                    android:textSize="15sp" />

            </LinearLayout>

            <Button
                android:id="@+id/formBackButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Back to handovers"
                android:textSize="16sp"
                android:minHeight="52dp" />

        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- Startup screen overlay: forest green with the logo and facility
         name, held about 1.5 seconds by MainActivity so it is actually
         seen, then lifted to reveal the home screen. It sits above the
         ScrollView and eats touches while it is up. -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/forest_900"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="Oluwatodupefun Maternity Home logo"
            android:src="@drawable/omh_logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Oluwatodupefun Maternity Home"
            android:textColor="@color/gold"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="OMH Mini — Attendance &amp; Handover"
            android:textColor="@color/sage"
            android:textSize="15sp" />

    </LinearLayout>

</FrameLayout>
